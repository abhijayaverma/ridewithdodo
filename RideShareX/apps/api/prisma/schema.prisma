generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum RideStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  REFUNDED
  FAILED
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  phone           String         @unique
  passwordHash    String
  role            UserRole       @default(PASSENGER)
  avatarUrl       String?
  phoneVerifiedAt DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  driver          Driver?
  bookings        Booking[]      @relation("PassengerBookings")
  reviewsWritten  Review[]       @relation("ReviewsWritten")
  notifications   Notification[]
  wallet          Wallet?
}

model Driver {
  id                 String               @id @default(uuid())
  userId             String               @unique
  user               User                 @relation(fields: [userId], references: [id])
  verificationStatus VerificationStatus   @default(PENDING)
  reliabilityScore   Decimal              @default(100)
  ratingAverage      Decimal              @default(0)
  ratingCount        Int                  @default(0)
  earnings           Decimal              @default(0)
  vehicles           Vehicle[]
  rides              Ride[]
  documents          DriverVerification[]
}

model Vehicle {
  id        String   @id @default(uuid())
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id])
  type      String
  model     String
  number    String   @unique
  isAc      Boolean  @default(true)
  photos    String[]
  createdAt DateTime @default(now())
  rides     Ride[]
}

model DriverVerification {
  id              String             @id @default(uuid())
  driverId        String
  driver          Driver             @relation(fields: [driverId], references: [id])
  type            String
  fileUrl         String
  status          VerificationStatus @default(UNDER_REVIEW)
  rejectionReason String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
}

model Ride {
  id                   String     @id @default(uuid())
  driverId             String
  vehicleId            String
  driver               Driver     @relation(fields: [driverId], references: [id])
  vehicle              Vehicle    @relation(fields: [vehicleId], references: [id])
  sourceAddress        String
  sourceLat            Decimal
  sourceLng            Decimal
  destinationAddress   String
  destinationLat        Decimal
  destinationLng        Decimal
  departureAt          DateTime
  estimatedArrivalAt   DateTime?
  pricePerSeat         Decimal
  totalSeats           Int
  remainingSeats       Int
  luggageAllowance     String?
  genderPreference     String?
  instantBooking       Boolean    @default(false)
  status               RideStatus @default(DRAFT)
  cancellationReason   String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  stops                RideStop[]
  bookings             Booking[]
  chat                 Chat?
  reports              Report[]

  @@index([departureAt, status])
}

model RideStop {
  id       String  @id @default(uuid())
  rideId   String
  ride     Ride    @relation(fields: [rideId], references: [id])
  address  String
  lat      Decimal
  lng      Decimal
  sequence Int
}

model Booking {
  id                 String        @id @default(uuid())
  passengerId        String
  passenger          User          @relation("PassengerBookings", fields: [passengerId], references: [id])
  rideId             String
  ride               Ride          @relation(fields: [rideId], references: [id])
  seats              Int
  pickupAddress      String
  dropAddress        String
  fare               Decimal
  status             BookingStatus @default(PENDING)
  cancellationReason String?
  createdAt          DateTime      @default(now())
  payments           Payment[]
  review             Review?
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  userId            String
  amount            Decimal
  currency          String        @default("INR")
  provider          String
  status            PaymentStatus @default(PENDING)
  providerPaymentId String?
  createdAt         DateTime      @default(now())
}

model Review {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id])
  reviewerId  String
  reviewer    User     @relation("ReviewsWritten", fields: [reviewerId], references: [id])
  driverId    String?
  rating      Int
  driving     Int?
  punctuality Int?
  cleanliness Int?
  behavior    Int?
  safety      Int?
  comment     String?
  moderatedAt DateTime?
  createdAt   DateTime @default(now())
}

model Rating {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  category   String
  value      Int
  createdAt  DateTime @default(now())
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  channel   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Chat {
  id        String    @id @default(uuid())
  rideId    String    @unique
  ride      Ride      @relation(fields: [rideId], references: [id])
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id        String    @id @default(uuid())
  chatId    String
  chat      Chat      @relation(fields: [chatId], references: [id])
  senderId  String
  body      String
  imageUrl  String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Wallet {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id])
  balance      Decimal       @default(0)
  transactions Transaction[]
}

model Transaction {
  id        String   @id @default(uuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  type      String
  amount    Decimal
  reference String?
  createdAt DateTime @default(now())
}

model Referral {
  id             String    @id @default(uuid())
  referrerId     String
  referredUserId String?
  code           String    @unique
  rewardAmount   Decimal   @default(0)
  convertedAt    DateTime?
  createdAt      DateTime  @default(now())
}

model Report {
  id             String   @id @default(uuid())
  reporterId     String
  reportedUserId String?
  rideId         String?
  ride           Ride?    @relation(fields: [rideId], references: [id])
  category       String
  description    String
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
}

model EmergencyContact {
  id           String  @id @default(uuid())
  userId       String
  name         String
  phone        String
  relationship String?
}

model Coupon {
  id           String    @id @default(uuid())
  code         String    @unique
  discountType String
  value        Decimal
  expiresAt    DateTime?
  maxUses      Int?
  usedCount    Int       @default(0)
  active       Boolean   @default(true)
}

model AdminLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}
