{
  "name": "ridesharex",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev --workspace @ridesharex/api & npm run dev --workspace @ridesharex/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "db:migrate": "npm run db:migrate --workspace @ridesharex/api",
    "db:studio": "npm run db:studio --workspace @ridesharex/api"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
